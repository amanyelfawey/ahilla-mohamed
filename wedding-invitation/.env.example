# ─────────────────────────────────────────────────────────────
#  Ahilla & Mohamed — Wedding site configuration
#  Copy this file to ".env" and fill in your own values.
#  NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# Port the site + upload API run on
PORT=4000

# ── Google Drive ─────────────────────────────────────────────
# The Drive folder that guest photos are uploaded into.
# Get the ID from the folder URL:
# https://drive.google.com/drive/folders/<THIS_IS_THE_FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=

# Path to your Google service account JSON key file.
# Keep this file OUTSIDE the public folder. Example: ./secrets/service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/service-account.json

# Alternative to the key file: paste the whole service account JSON,
# base64-encoded, into this variable (useful for Vercel/Railway/Render).
# If set, this takes priority over GOOGLE_SERVICE_ACCOUNT_KEY_FILE.
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# Optional: If your Drive folder lives in a Shared Drive, set its ID here.
GOOGLE_SHARED_DRIVE_ID=

# ── Upload rules ─────────────────────────────────────────────
MAX_PHOTOS_PER_GUEST=10
MAX_FILE_SIZE_MB=15

# ── Local fallback ───────────────────────────────────────────
# When Google Drive is not configured, uploads are saved here instead
# so the feature still works during development.
LOCAL_UPLOAD_DIR=./uploads
